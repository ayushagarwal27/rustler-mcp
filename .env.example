# Main connection string (same one your web app uses).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional but STRONGLY recommended: a dedicated read-only Postgres role,
# since this server queries your production DB directly.
# Falls back to DATABASE_URL when unset. See README for the GRANT script.
DATABASE_URL_RO=

MCP_SERVER_NAME=Rustler
LOG_LEVEL=INFO
